<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GetHome.Components.ChipView"
             x:Name="ChipRoot">

    <Border Padding="16,10" StrokeShape="RoundRectangle 14" StrokeThickness="1.5"
            Stroke="{StaticResource Neutral}" BackgroundColor="Transparent"
            VerticalOptions="Center">
        <Border.Triggers>
            <DataTrigger TargetType="Border" Binding="{Binding IsSelected, Source={x:Reference ChipRoot}}" Value="True">
                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                <Setter Property="Stroke" Value="{StaticResource Primary}" />
            </DataTrigger>
        </Border.Triggers>
        <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding Command, Source={x:Reference ChipRoot}}"
                                  CommandParameter="{Binding CommandParameter, Source={x:Reference ChipRoot}}" />
        </Border.GestureRecognizers>
        <Label Text="{Binding Text, Source={x:Reference ChipRoot}}"
               FontFamily="InterSemiBold" FontSize="14" HorizontalTextAlignment="Center">
            <Label.Triggers>
                <DataTrigger TargetType="Label" Binding="{Binding IsSelected, Source={x:Reference ChipRoot}}" Value="True">
                    <Setter Property="TextColor" Value="{StaticResource White}" />
                </DataTrigger>
            </Label.Triggers>
        </Label>
    </Border>
</ContentView>
