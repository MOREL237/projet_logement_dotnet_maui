<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GetHome.ViewModels"
             xmlns:loc="clr-namespace:GetHome.Localization"
             x:Class="GetHome.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             Shell.NavBarIsVisible="False"
             Title="{loc:Translate Login_Title}">

    <ScrollView>
        <VerticalStackLayout Padding="20,72,20,24" Spacing="24" MaximumWidthRequest="480">

            <!-- Logo -->
            <HorizontalStackLayout Spacing="12" Margin="0,0,0,24">
                <Image Source="logo_gethome.svg" WidthRequest="40" HeightRequest="40" VerticalOptions="Center" />
                <Label Text="GetHome" Style="{StaticResource Headline}" FontSize="28" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <!-- Bannière d'erreur générale (identifiants incorrects, réseau) -->
            <Border IsVisible="{Binding HasError}"
                    StrokeShape="RoundRectangle 16"
                    Stroke="{StaticResource Error}"
                    StrokeThickness="1"
                    Padding="16,12"
                    BackgroundColor="Transparent">
                <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" FontSize="14" />
            </Border>

            <!-- E-mail -->
            <VerticalStackLayout Spacing="8">
                <Label Text="{loc:Translate Common_Email}" Style="{StaticResource Subtitle}" FontSize="14" />
                <Border Style="{StaticResource FieldBorder}">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding HasEmailError}" Value="True">
                            <Setter Property="Stroke" Value="{StaticResource Error}" />
                            <Setter Property="StrokeThickness" Value="1.5" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Entry Text="{Binding Email}"
                               Placeholder="{loc:Translate Common_EmailPlaceholder}"
                               Keyboard="Email"
                               VerticalOptions="Center"
                               IsEnabled="{Binding IsNotBusy}" />
                        <Image Grid.Column="1"
                               Source="error_circle.svg"
                               WidthRequest="22" HeightRequest="22"
                               VerticalOptions="Center"
                               IsVisible="{Binding HasEmailError}" />
                    </Grid>
                </Border>
                <Label Text="{Binding EmailError}" IsVisible="{Binding HasEmailError}" Style="{StaticResource ErrorText}" FontFamily="InterSemiBold" />
            </VerticalStackLayout>

            <!-- Mot de passe -->
            <VerticalStackLayout Spacing="8">
                <Label Text="{loc:Translate Common_Password}" Style="{StaticResource Subtitle}" FontSize="14" />
                <Border Style="{StaticResource FieldBorder}">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding HasPasswordError}" Value="True">
                            <Setter Property="Stroke" Value="{StaticResource Error}" />
                            <Setter Property="StrokeThickness" Value="1.5" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Grid ColumnDefinitions="*,Auto">
                        <Entry Text="{Binding Password}"
                               Placeholder="{loc:Translate Common_PasswordPlaceholder}"
                               IsPassword="{Binding IsPasswordHidden}"
                               VerticalOptions="Center"
                               IsEnabled="{Binding IsNotBusy}" />
                        <ImageButton Grid.Column="1"
                                     Source="{Binding PasswordToggleIcon}"
                                     Command="{Binding TogglePasswordCommand}"
                                     BackgroundColor="Transparent"
                                     WidthRequest="44" HeightRequest="44"
                                     Padding="10"
                                     VerticalOptions="Center"
                                     SemanticProperties.Description="{loc:Translate Common_ShowPassword}" />
                    </Grid>
                </Border>
                <Label Text="{Binding PasswordError}" IsVisible="{Binding HasPasswordError}" Style="{StaticResource ErrorText}" FontFamily="InterSemiBold" />

                <Label Text="{loc:Translate Login_Forgot}"
                        FontFamily="InterSemiBold" FontSize="14"
                        TextDecorations="Underline"
                        HorizontalOptions="End"
                        Padding="0,8">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ForgotPasswordCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </VerticalStackLayout>

            <!-- Action principale -->
            <VerticalStackLayout Spacing="16">
                <Button Text="{Binding LoginButtonText}" Command="{Binding LoginCommand}" />
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HeightRequest="24" />
            </VerticalStackLayout>

            <!-- Lien vers l'inscription -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                <Label Text="{loc:Translate Login_NoAccount}" Style="{StaticResource Caption}" FontSize="15" VerticalOptions="Center" />
                <Label Text="{loc:Translate Login_CreateAccount}"
                        FontFamily="InterSemiBold" FontSize="15"
                        TextDecorations="Underline"
                        VerticalOptions="Center"
                        Padding="0,12">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToRegisterCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
