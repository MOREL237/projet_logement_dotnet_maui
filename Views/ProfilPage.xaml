<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GetHome.ViewModels"
             xmlns:components="clr-namespace:GetHome.Components"
             xmlns:loc="clr-namespace:GetHome.Localization"
             x:Class="GetHome.Views.ProfilPage"
             x:DataType="vm:ProfilViewModel"
             Shell.NavBarIsVisible="False"
             Title="{loc:Translate Profil_Title}">

    <ScrollView>
        <VerticalStackLayout Padding="20,28,20,24" Spacing="20" MaximumWidthRequest="560">

            <!-- En-tête -->
            <VerticalStackLayout Spacing="4">
                <Grid ColumnDefinitions="Auto,*">
                    <Label Grid.Column="0" Text="11" FontFamily="InterBold" FontSize="14"
                           TextColor="{StaticResource Gray500}" VerticalOptions="Center" Margin="0,0,10,0" />
                    <Label Grid.Column="1" Text="{loc:Translate Profil_Title}" Style="{StaticResource Headline}" FontSize="24"
                           VerticalOptions="Center" />
                </Grid>
                <Label Style="{StaticResource Caption}" FontSize="12">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{loc:Translate Profil_Certified}" />
                            <Span Text="{Binding Profile.GetHomeId}" FontFamily="InterSemiBold" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </VerticalStackLayout>

            <!-- Carte profil -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Grid.Column="0" StrokeShape="RoundRectangle 999" StrokeThickness="0"
                                WidthRequest="56" HeightRequest="56" BackgroundColor="{Binding Profile.AvatarTint}">
                            <Label Text="{Binding Profile.Initials}" FontFamily="InterBold" FontSize="18"
                                   TextColor="{StaticResource Gray900}"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                            <Label Text="{Binding Profile.FullName}" FontFamily="InterBold" FontSize="18" />
                            <Label Text="{Binding Profile.Email}" Style="{StaticResource Caption}" />
                            <Label Text="{Binding Profile.Phone}" Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <components:ChipView Grid.Column="0" Text="{loc:Translate Profil_Owner}" HorizontalOptions="Fill"
                                             IsSelected="{Binding IsOwnerModeSelected}" Command="{Binding SelectOwnerModeCommand}" />
                        <components:ChipView Grid.Column="1" Text="{loc:Translate Profil_Tenant}" HorizontalOptions="Fill"
                                             IsSelected="{Binding IsTenantModeSelected}" Command="{Binding SelectTenantModeCommand}" />
                    </Grid>
                    <Label Text="{Binding ModeLabel}" Style="{StaticResource Caption}" HorizontalTextAlignment="Center" />

                    <Button Text="{loc:Translate Profil_EditInfo}" Style="{StaticResource SecondaryButton}"
                            Command="{Binding EditInfoCommand}" />
                </VerticalStackLayout>
            </Border>

            <!-- Dossier de candidature -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{loc:Translate Profil_Dossier}" Style="{StaticResource Subtitle}" FontSize="15" />
                        <Label Grid.Column="1" Text="{Binding DossierCompletionText}" Style="{StaticResource Caption}"
                               TextColor="{StaticResource Success}" VerticalOptions="Center" />
                    </Grid>
                    <FlexLayout Direction="Row" Wrap="Wrap" JustifyContent="Start"
                                BindableLayout.ItemsSource="{Binding Profile.DossierItems}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border StrokeShape="RoundRectangle 999" StrokeThickness="1"
                                        Stroke="{StaticResource Neutral}" Padding="12,6" Margin="0,0,8,8">
                                    <Label Text="{Binding .}" FontSize="13" />
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                    <Label Text="Dossier chiffré sur serveur local bas-carbone. Transmis aux bailleurs uniquement avec votre consentement exprès."
                           Style="{StaticResource Caption}" FontSize="12" />
                </VerticalStackLayout>
            </Border>

            <!-- Énergie & affichage -->
            <VerticalStackLayout Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="{loc:Translate Profil_EnergySection}" Style="{StaticResource Caption}" FontSize="11"
                           CharacterSpacing="1.5" VerticalOptions="Center" />
                    <Border Grid.Column="1" StrokeShape="RoundRectangle 999" StrokeThickness="0"
                            BackgroundColor="{StaticResource Secondary}" Padding="10,4">
                        <Label Text="{loc:Translate Profil_Sobriety}" FontSize="11" FontFamily="InterSemiBold" />
                    </Border>
                </Grid>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="{loc:Translate Profil_DarkMode}" FontSize="15" FontFamily="InterSemiBold" />
                        <Label Text="{loc:Translate Profil_DarkModeDesc}"
                               Style="{StaticResource Caption}" FontSize="12" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" IsToggled="{Binding DarkMode}" VerticalOptions="Center" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="{loc:Translate Profil_LowData}" FontSize="15" FontFamily="InterSemiBold" />
                        <Label Text="{loc:Translate Profil_LowDataDesc}"
                               Style="{StaticResource Caption}" FontSize="12" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" IsToggled="{Binding LowDataDisplay}" VerticalOptions="Center" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="{loc:Translate Profil_PurgeCache}" FontSize="15" FontFamily="InterSemiBold" />
                        <Label Text="{Binding CacheSizeText}" Style="{StaticResource Caption}" FontSize="12" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="{loc:Translate Profil_Clear}" Style="{StaticResource OutlinedButton}"
                            HeightRequest="40" FontSize="13" Padding="16,0" VerticalOptions="Center"
                            Command="{Binding ClearCacheCommand}" />
                </Grid>
            </VerticalStackLayout>

            <!-- Notifications -->
            <VerticalStackLayout Spacing="10">
                <Label Text="{loc:Translate Profil_NotifSection}" Style="{StaticResource Caption}" FontSize="11"
                       CharacterSpacing="1.5" />

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="{loc:Translate Profil_NotifAlerts}" FontSize="15" FontFamily="InterSemiBold" />
                        <Label Text="{loc:Translate Profil_NotifAlertsDesc}"
                               Style="{StaticResource Caption}" FontSize="12" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" IsToggled="{Binding AlertsNewHomes}" VerticalOptions="Center" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="{loc:Translate Profil_NotifMessages}" FontSize="15" FontFamily="InterSemiBold" />
                        <Label Text="{loc:Translate Profil_NotifMessagesDesc}"
                               Style="{StaticResource Caption}" FontSize="12" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" IsToggled="{Binding MessageNotifications}" VerticalOptions="Center" />
                </Grid>
            </VerticalStackLayout>

            <!-- Préférences -->
            <VerticalStackLayout Spacing="4">
                <Label Text="{loc:Translate Profil_PrefsSection}" Style="{StaticResource Caption}" FontSize="11"
                       CharacterSpacing="1.5" Margin="0,0,0,6" />

                <Grid ColumnDefinitions="*,Auto" Padding="0,12" ColumnSpacing="12">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleLanguageCommand}" />
                    </Grid.GestureRecognizers>
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="{Binding LanguageRowText}" FontSize="15" />
                        <Label Text="{Binding LanguageText}" Style="{StaticResource Caption}" FontSize="12" />
                    </VerticalStackLayout>
                    <Border Grid.Column="1" Padding="16,8" StrokeShape="RoundRectangle 999" StrokeThickness="1"
                            Stroke="{StaticResource Primary}" BackgroundColor="Transparent"
                            VerticalOptions="Center">
                        <Label Text="{Binding LanguageText}" FontFamily="InterSemiBold" FontSize="13" />
                    </Border>
                </Grid>

                <BoxView HeightRequest="1" Color="{StaticResource Neutral}" />

                <Grid ColumnDefinitions="*,Auto" Padding="0,12">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SecurityCommand}" />
                    </Grid.GestureRecognizers>
                    <Label Text="{loc:Translate Profil_Security}" FontSize="15" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="›" FontSize="18" TextColor="{StaticResource Gray500}"
                           VerticalOptions="Center" />
                </Grid>

                <BoxView HeightRequest="1" Color="{StaticResource Neutral}" />

                <Grid ColumnDefinitions="*,Auto" Padding="0,12" ColumnSpacing="12">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding PrivacyCommand}" />
                    </Grid.GestureRecognizers>
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="{loc:Translate Profil_Privacy}" FontSize="15" />
                        <Label Text="{loc:Translate Profil_PrivacyDesc}"
                               Style="{StaticResource Caption}" FontSize="12" />
                    </VerticalStackLayout>
                    <Label Grid.Column="1" Text="›" FontSize="18" TextColor="{StaticResource Gray500}"
                           VerticalOptions="Center" />
                </Grid>
            </VerticalStackLayout>

            <!-- Actions -->
            <VerticalStackLayout Spacing="12">
                <Button Text="{loc:Translate Profil_Publish}" Command="{Binding PublishCommand}" HeightRequest="50" />
                <Button Text="{loc:Translate Profil_Logout}" Style="{StaticResource OutlinedButton}"
                        Command="{Binding LogoutCommand}" HeightRequest="50" />
                <Label Text="{loc:Translate Profil_Delete}" HorizontalTextAlignment="Center"
                       FontSize="13" TextColor="{StaticResource Error}" Padding="0,8">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding DeleteAccountCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </VerticalStackLayout>

            <!-- Pied -->
            <VerticalStackLayout Spacing="4">
                <Label Text="{Binding CarbonLabel}" Style="{StaticResource Caption}" FontSize="11"
                       HorizontalTextAlignment="Center" />
                <Label Text="{Binding AppVersionText}" Style="{StaticResource Caption}" FontSize="11"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
