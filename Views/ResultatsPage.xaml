<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GetHome.ViewModels"
             xmlns:models="clr-namespace:GetHome.Models"
             x:Class="GetHome.Views.ResultatsPage"
             x:DataType="vm:ResultatsViewModel"
             Shell.NavBarIsVisible="False"
             Title="Résultats">

    <Grid RowDefinitions="Auto,*">

        <!-- En-tête -->
        <VerticalStackLayout Grid.Row="0" Padding="20,28,20,12" Spacing="12">

            <Grid ColumnDefinitions="Auto,*,Auto">
                <Label Grid.Column="0" Text="‹" FontSize="26" VerticalOptions="Center" Padding="0,0,12,0">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                    </Label.GestureRecognizers>
                </Label>
                <Button Grid.Column="1" Text="{Binding FilterButtonText}" Style="{StaticResource SecondaryButton}"
                        HeightRequest="42" FontSize="14" HorizontalOptions="Start" Padding="16,0"
                        Command="{Binding OpenFilterCommand}" />
                <Label Grid.Column="2" Text="{Binding SortText}" Style="{StaticResource Caption}"
                       VerticalOptions="Center" />
            </Grid>

            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                <Button Grid.Column="0" Text="Liste" HeightRequest="38" FontSize="13" Padding="16,0"
                        Command="{Binding ShowListCommand}" />
                <Button Grid.Column="1" Text="Carte" Style="{StaticResource SecondaryButton}"
                        HeightRequest="38" FontSize="13" Padding="16,0"
                        Command="{Binding ShowMapViewCommand}" />
                <Label Grid.Column="2" Text="{Binding ResultCountText}" Style="{StaticResource Caption}"
                       VerticalOptions="Center" HorizontalTextAlignment="End" />
            </Grid>

            <Label Text="Affichage optimisé : une seule image basse consommation par annonce pour limiter le transfert réseau."
                   Style="{StaticResource Caption}" FontSize="12" />
        </VerticalStackLayout>

        <!-- Liste -->
        <ScrollView Grid.Row="1" IsVisible="{Binding IsListView}">
            <VerticalStackLayout Padding="20,0,20,24" Spacing="16" MaximumWidthRequest="560">

                <VerticalStackLayout Spacing="16" BindableLayout.ItemsSource="{Binding Listings}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:Listing">
                            <Border Style="{StaticResource Card}">
                                <VerticalStackLayout Spacing="10">
                                    <Grid ColumnDefinitions="100,*" ColumnSpacing="12">
                                        <Border StrokeShape="RoundRectangle 12" StrokeThickness="0"
                                                WidthRequest="100" HeightRequest="100"
                                                BackgroundColor="{Binding ImageTint}">
                                            <Label Text="{Binding Neighborhood}" FontFamily="InterBold" FontSize="13"
                                                   TextColor="{StaticResource Gray900}" Padding="8"
                                                   VerticalOptions="End" LineBreakMode="TailTruncation" />
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                                            <Border StrokeShape="RoundRectangle 999" StrokeThickness="0"
                                                    BackgroundColor="{StaticResource Secondary}" Padding="8,3"
                                                    HorizontalOptions="Start" IsVisible="{Binding AvailableNow}">
                                                <Label Text="Dispo immédiate" FontSize="10" FontFamily="InterSemiBold"
                                                       TextColor="{StaticResource Gray900}" />
                                            </Border>
                                            <Label Text="{Binding Title}" FontFamily="InterSemiBold" FontSize="15" />
                                            <Label Text="{Binding Neighborhood}" Style="{StaticResource Caption}" />
                                            <Label Text="{Binding FeaturesText}" Style="{StaticResource Caption}" />
                                            <HorizontalStackLayout Spacing="4">
                                                <Label Text="{Binding PriceText}" FontFamily="InterBold" FontSize="17" />
                                                <Label Text="{Binding PriceUnit}" Style="{StaticResource Caption}"
                                                       VerticalOptions="End" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="10">
                                        <Button Grid.Column="0" Text="Détails" HeightRequest="42" FontSize="14"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ResultatsViewModel}}, Path=OpenDetailCommand}"
                                                CommandParameter="{Binding .}" />
                                        <Button Grid.Column="1" Text="Contacter" Style="{StaticResource SecondaryButton}"
                                                HeightRequest="42" FontSize="14"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ResultatsViewModel}}, Path=ContactCommand}"
                                                CommandParameter="{Binding .}" />
                                        <Border Grid.Column="2" StrokeShape="RoundRectangle 8" StrokeThickness="1"
                                                Stroke="{StaticResource Neutral}" Padding="10,6" VerticalOptions="Center"
                                                IsVisible="{Binding EcoClass, Converter={StaticResource IsNotEmpty}}">
                                            <Label Text="{Binding EcoClass, StringFormat='Éco {0}'}" FontSize="13" FontFamily="InterSemiBold" />
                                        </Border>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Charger plus -->
                <VerticalStackLayout Spacing="6">
                    <Button Text="Charger plus (10 suivantes)" Style="{StaticResource OutlinedButton}"
                            Command="{Binding LoadMoreCommand}" />
                    <Label Text="Pas de défilement infini pour limiter la consommation réseau et batterie."
                           Style="{StaticResource Caption}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HeightRequest="24" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- Carte -->
        <VerticalStackLayout Grid.Row="1" IsVisible="{Binding IsMapView}" Padding="20" Spacing="10">
            <Border StrokeShape="RoundRectangle 16" StrokeThickness="0"
                    BackgroundColor="{StaticResource Secondary}" VerticalOptions="FillAndExpand"
                    HorizontalOptions="FillAndExpand">
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8">
                    <Label Text="Vue carte" Style="{StaticResource Subtitle}" HorizontalOptions="Center" />
                    <Label Text="Rendu cartographique à venir (données allégées)." Style="{StaticResource Caption}"
                           HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>
            <Label Text="Affichage optimisé : marqueurs chargés à la demande." Style="{StaticResource Caption}"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

    </Grid>
</ContentPage>
