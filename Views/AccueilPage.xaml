<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GetHome.ViewModels"
             xmlns:models="clr-namespace:GetHome.Models"
             xmlns:loc="clr-namespace:GetHome.Localization"
             x:Class="GetHome.Views.AccueilPage"
             x:DataType="vm:AccueilViewModel"
             Shell.NavBarIsVisible="False"
             Title="{loc:Translate Accueil_Title}">

    <ScrollView>
        <VerticalStackLayout Padding="20,32,20,24" Spacing="20" MaximumWidthRequest="560">

            <!-- En-tête -->
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                    <Image Source="logo_gethome.svg" WidthRequest="34" HeightRequest="34" VerticalOptions="Center" />
                    <Label Text="GetHome" Style="{StaticResource Headline}" FontSize="22" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Label Grid.Column="2" Text="douala-cameroun" Style="{StaticResource Caption}"
                       VerticalOptions="Center" />
            </Grid>

            <Label Text="{loc:Translate Accueil_Tagline}"
                   Style="{StaticResource Caption}" FontSize="13" />

            <!-- Salutation -->
            <VerticalStackLayout Spacing="6">
                <Label Text="{Binding Greeting}" Style="{StaticResource Headline}" FontSize="26" />
                <Border StrokeShape="RoundRectangle 999" StrokeThickness="0"
                        BackgroundColor="{StaticResource Secondary}" HorizontalOptions="Start" Padding="12,6">
                    <Label Text="{Binding AlertsText}" FontFamily="InterSemiBold" FontSize="12"
                           TextColor="{StaticResource Gray900}" />
                </Border>
            </VerticalStackLayout>

            <!-- Recherches enregistrées -->
            <VerticalStackLayout Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="{loc:Translate Accueil_SavedSearches}" Style="{StaticResource Subtitle}" FontSize="18" />
                    <Border Grid.Column="1" StrokeShape="RoundRectangle 999" StrokeThickness="0"
                            BackgroundColor="{StaticResource Secondary}" Padding="10,5" VerticalOptions="Center">
                        <Label Text="{loc:Translate Accueil_EcoAlertActive}" FontFamily="InterSemiBold" FontSize="11"
                               TextColor="{StaticResource Success}" />
                    </Border>
                </Grid>

                <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding SavedSearches}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:SavedSearch">
                            <Border Style="{StaticResource Card}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                                        <Label Text="{Binding Title}" FontFamily="InterSemiBold" FontSize="15" />
                                        <Label Text="{Binding Summary}" Style="{StaticResource Caption}" />
                                        <Label Text="{Binding NewCountText}" FontSize="13"
                                               TextColor="{StaticResource Success}" FontFamily="InterSemiBold" />
                                    </VerticalStackLayout>
                                    <Button Grid.Column="1" Text="{loc:Translate Accueil_Refresh}" Style="{StaticResource SecondaryButton}"
                                            HeightRequest="40" FontSize="14" Padding="16,0"
                                            VerticalOptions="Center"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AccueilViewModel}}, Path=OpenSearchCommand}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Annonces récentes -->
            <VerticalStackLayout Spacing="4">
                <Label Text="{loc:Translate Accueil_RecentListings}" Style="{StaticResource Subtitle}" FontSize="18" />
                <Label Text="{loc:Translate Accueil_VerifiedNoMiddle}" Style="{StaticResource Caption}" />
            </VerticalStackLayout>

            <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Grid.Column="0" StrokeShape="RoundRectangle 999" StrokeThickness="0"
                        BackgroundColor="{StaticResource Secondary}" Padding="10,5">
                    <Label Text="{loc:Translate Accueil_AvailableNow}" FontFamily="InterSemiBold" FontSize="11"
                           TextColor="{StaticResource Gray900}" />
                </Border>
                <Label Grid.Column="2" Text="{loc:Translate Accueil_FilterByDate}" FontFamily="InterSemiBold" FontSize="13"
                       TextDecorations="Underline" VerticalOptions="Center" Padding="0,8">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding FilterCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>

            <!-- Cartes annonces -->
            <VerticalStackLayout Spacing="16" BindableLayout.ItemsSource="{Binding Listings}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:Listing">
                        <Border Style="{StaticResource Card}" Padding="12">
                            <VerticalStackLayout Spacing="12">

                                <!-- Visuel (placeholder basse consommation) -->
                                <Border StrokeShape="RoundRectangle 12" StrokeThickness="0"
                                        HeightRequest="150" BackgroundColor="{Binding ImageTint}">
                                    <Grid Padding="12">
                                        <Label Text="{Binding Neighborhood}" FontFamily="InterBold" FontSize="20"
                                               TextColor="{StaticResource Gray900}" VerticalOptions="End" />
                                        <Border HorizontalOptions="End" VerticalOptions="Start"
                                                StrokeShape="RoundRectangle 999" StrokeThickness="0"
                                                BackgroundColor="{StaticResource Primary}" Padding="10,5"
                                                IsVisible="{Binding AvailableNow}">
                                            <Label Text="{loc:Translate Accueil_AvailableNow}" FontSize="10" FontFamily="InterSemiBold"
                                                   TextColor="{StaticResource White}" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Prix + infos -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <VerticalStackLayout Grid.Column="0" Spacing="3">
                                        <Label Text="{Binding Title}" FontFamily="InterSemiBold" FontSize="16" />
                                        <Label Text="{Binding Neighborhood}" Style="{StaticResource Caption}" />
                                        <Label Text="{Binding FeaturesText}" Style="{StaticResource Caption}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="0" HorizontalOptions="End">
                                        <Label Text="{Binding PriceText}" FontFamily="InterBold" FontSize="18"
                                               HorizontalTextAlignment="End" />
                                        <Label Text="{Binding PriceUnit}" Style="{StaticResource Caption}"
                                               HorizontalTextAlignment="End" />
                                    </VerticalStackLayout>
                                </Grid>

                                <!-- Éco-classe + étage + dispo -->
                                <FlexLayout Direction="Row" Wrap="Wrap" JustifyContent="Start">
                                    <Border StrokeShape="RoundRectangle 8" StrokeThickness="1"
                                            Stroke="{StaticResource Neutral}" Padding="8,3" Margin="0,0,8,6"
                                            IsVisible="{Binding EcoClass, Converter={StaticResource IsNotEmpty}}">
                                        <Label FontSize="12" FontFamily="InterSemiBold">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{loc:Translate Accueil_EcoBadgePrefix}" />
                                                    <Span Text="{Binding EcoClass}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </Border>
                                    <Border StrokeShape="RoundRectangle 8" StrokeThickness="1"
                                            Stroke="{StaticResource Neutral}" Padding="8,3" Margin="0,0,8,6">
                                        <Label Text="{Binding Floor}" FontSize="12" />
                                    </Border>
                                    <Border StrokeShape="RoundRectangle 8" StrokeThickness="1"
                                            Stroke="{StaticResource Neutral}" Padding="8,3" Margin="0,0,8,6">
                                        <Label Text="{Binding Rooms}" FontSize="12" />
                                    </Border>
                                    <Border StrokeShape="RoundRectangle 8" StrokeThickness="1"
                                            Stroke="{StaticResource Neutral}" Padding="8,3" Margin="0,0,8,6">
                                        <Label Text="{Binding Availability}" FontSize="12" />
                                    </Border>
                                </FlexLayout>

                                <!-- Actions -->
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <Button Grid.Column="0" Text="{loc:Translate Accueil_ViewListing}" HeightRequest="44" FontSize="14"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AccueilViewModel}}, Path=OpenListingCommand}"
                                            CommandParameter="{Binding .}" />
                                    <Button Grid.Column="1" Text="{loc:Translate Accueil_Contact}" Style="{StaticResource SecondaryButton}"
                                            HeightRequest="44" FontSize="14"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AccueilViewModel}}, Path=ContactCommand}"
                                            CommandParameter="{Binding .}" />
                                </Grid>

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- Note écoconception -->
            <Border StrokeShape="RoundRectangle 16" StrokeThickness="1" Stroke="{StaticResource Neutral}"
                    Padding="16" BackgroundColor="Transparent">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{loc:Translate Accueil_EcoNoteTitle}" FontFamily="InterSemiBold" FontSize="14" />
                    <Label Style="{StaticResource Caption}"
                           Text="{loc:Translate Accueil_EcoNoteDetail}" />
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HeightRequest="24" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
