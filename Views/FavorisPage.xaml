<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GetHome.ViewModels"
             xmlns:models="clr-namespace:GetHome.Models"
             xmlns:loc="clr-namespace:GetHome.Localization"
             x:Class="GetHome.Views.FavorisPage"
             x:DataType="vm:FavorisViewModel"
             Shell.NavBarIsVisible="False"
             Title="{loc:Translate Favoris_Title}">

    <Grid RowDefinitions="Auto,*">

        <!-- En-tête -->
        <VerticalStackLayout Grid.Row="0" Padding="20,28,20,8" Spacing="4">
            <Label Text="{loc:Translate Favoris_Title}" Style="{StaticResource Headline}" FontSize="24" />
            <Label Text="{Binding CountText}" Style="{StaticResource Caption}" />
        </VerticalStackLayout>

        <!-- Liste -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,8,20,24" Spacing="16" MaximumWidthRequest="560">

                <Label Text="{loc:Translate Favoris_Empty}"
                       Style="{StaticResource Caption}" HorizontalTextAlignment="Center" Margin="0,40,0,0"
                       IsVisible="{Binding IsEmpty}" />

                <VerticalStackLayout Spacing="16" BindableLayout.ItemsSource="{Binding Favorites}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:Listing">
                            <Border Style="{StaticResource Card}">
                                <VerticalStackLayout Spacing="10">
                                    <Grid ColumnDefinitions="100,*" ColumnSpacing="12">
                                        <Border StrokeShape="RoundRectangle 12" StrokeThickness="0"
                                                WidthRequest="100" HeightRequest="100"
                                                BackgroundColor="{Binding ImageTint}">
                                            <Label Text="{Binding Neighborhood}" FontFamily="InterBold" FontSize="13"
                                                   TextColor="{StaticResource Gray900}" Padding="8"
                                                   VerticalOptions="End" LineBreakMode="TailTruncation" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                                            <Label Text="{Binding Title}" FontFamily="InterSemiBold" FontSize="15" />
                                            <Label Text="{Binding Neighborhood}" Style="{StaticResource Caption}" />
                                            <Label Text="{Binding FeaturesText}" Style="{StaticResource Caption}" />
                                            <HorizontalStackLayout Spacing="4">
                                                <Label Text="{Binding PriceText}" FontFamily="InterBold" FontSize="17" />
                                                <Label Text="{Binding PriceUnit}" Style="{StaticResource Caption}"
                                                       VerticalOptions="End" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                        <Button Grid.Column="0" Text="{loc:Translate Favoris_Details}" HeightRequest="42" FontSize="14"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FavorisViewModel}}, Path=OpenDetailCommand}"
                                                CommandParameter="{Binding .}" />
                                        <Button Grid.Column="1" Text="{loc:Translate Favoris_Remove}" Style="{StaticResource SecondaryButton}"
                                                HeightRequest="42" FontSize="14"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FavorisViewModel}}, Path=RemoveCommand}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
