<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GetHome.ViewModels"
             xmlns:loc="clr-namespace:GetHome.Localization"
             x:Class="GetHome.Views.ForgotPasswordPage"
             x:DataType="vm:ForgotPasswordViewModel"
             Shell.NavBarIsVisible="False"
             Title="{loc:Translate Forgot_Title}">

    <ScrollView>
        <VerticalStackLayout Padding="20,72,20,24" Spacing="20" MaximumWidthRequest="480">

            <!-- Pastille de section -->
            <Border StrokeShape="RoundRectangle 999" StrokeThickness="0"
                    BackgroundColor="{StaticResource Secondary}"
                    HorizontalOptions="Start" Padding="14,8">
                <Label Text="{loc:Translate Forgot_Security}" FontFamily="InterSemiBold" FontSize="12"
                       TextColor="{StaticResource Gray900}" CharacterSpacing="1" />
            </Border>

            <!-- Titres -->
            <VerticalStackLayout Spacing="6">
                <Label Text="{loc:Translate Forgot_AccessRecovery}" Style="{StaticResource Headline}" FontSize="26" />
                <Label Text="{loc:Translate Forgot_Title}" Style="{StaticResource Subtitle}" FontSize="18" />
            </VerticalStackLayout>

            <Label Style="{StaticResource Caption}" FontSize="15"
                   Text="{loc:Translate Forgot_Intro}" />

            <!-- ===== État 1 : formulaire ===== -->
            <VerticalStackLayout Spacing="16" IsVisible="{Binding IsNotSent}">

                <Border IsVisible="{Binding HasError}"
                        StrokeShape="RoundRectangle 16" Stroke="{StaticResource Error}"
                        StrokeThickness="1" Padding="16,12" BackgroundColor="Transparent">
                    <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" FontSize="14" />
                </Border>

                <VerticalStackLayout Spacing="8">
                    <Label Text="{loc:Translate Common_Email}" Style="{StaticResource Subtitle}" FontSize="14" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding HasEmailError}" Value="True">
                                <Setter Property="Stroke" Value="{StaticResource Error}" />
                                <Setter Property="StrokeThickness" Value="1.5" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Entry Text="{Binding Email}" Placeholder="{loc:Translate Common_EmailPlaceholder}" Keyboard="Email"
                                   VerticalOptions="Center" IsEnabled="{Binding IsNotBusy}" />
                            <Image Grid.Column="1" Source="error_circle.svg" WidthRequest="22" HeightRequest="22"
                                   VerticalOptions="Center" IsVisible="{Binding HasEmailError}" />
                        </Grid>
                    </Border>
                    <Label Text="{Binding EmailError}" IsVisible="{Binding HasEmailError}"
                           Style="{StaticResource ErrorText}" FontFamily="InterSemiBold" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="16">
                    <Button Text="{Binding SendButtonText}" Command="{Binding SendCommand}" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HeightRequest="24" />
                </VerticalStackLayout>

            </VerticalStackLayout>

            <!-- ===== État 2 : confirmation d'envoi ===== -->
            <VerticalStackLayout Spacing="16" IsVisible="{Binding IsSent}">

                <Border StrokeShape="RoundRectangle 16" Stroke="{StaticResource Success}"
                        StrokeThickness="1" Padding="16" BackgroundColor="Transparent">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{loc:Translate Forgot_Sent}" FontFamily="InterBold" FontSize="18" TextColor="{StaticResource Success}" />
                        <Label Style="{StaticResource Caption}" FontSize="15"
                               Text="{loc:Translate Forgot_SentDetail}" />
                    </VerticalStackLayout>
                </Border>

                <Border StrokeShape="RoundRectangle 16" Stroke="{StaticResource Neutral}"
                        StrokeThickness="1" Padding="16" BackgroundColor="Transparent">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{loc:Translate Forgot_EcoTitle}" FontFamily="InterSemiBold" FontSize="14" />
                        <Label Style="{StaticResource Caption}" Text="{loc:Translate Forgot_EcoDetail}" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>

            <!-- Retour à la connexion -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                <Label Text="{loc:Translate Forgot_BackToLogin}" FontFamily="InterSemiBold" FontSize="15"
                       TextDecorations="Underline" VerticalOptions="Center" Padding="0,12">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToLoginCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
