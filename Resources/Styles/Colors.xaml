<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ===== Palette GetHome (Figma) ===== -->
    <Color x:Key="Primary">#111111</Color>
    <Color x:Key="Secondary">#F5F5F5</Color>
    <Color x:Key="Tertiary">#121110</Color>
    <Color x:Key="Neutral">#E5E5E5</Color>
    <Color x:Key="PageBackground">#FAFAFA</Color>

    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>

    <!-- ===== Couleurs d'état ===== -->
    <Color x:Key="Error">#D92D20</Color>
    <Color x:Key="Success">#067647</Color>
    <Color x:Key="Warning">#B54708</Color>

    <!-- ===== Gris (à ajuster avec ta rampe Figma) ===== -->
    <Color x:Key="Gray100">#E5E5E5</Color>
    <Color x:Key="Gray200">#D4D4D4</Color>
    <Color x:Key="Gray300">#C8C8C8</Color>
    <Color x:Key="Gray400">#BDBDBD</Color>
    <Color x:Key="Gray500">#919191</Color>
    <Color x:Key="Gray600">#6B6B6B</Color>
    <Color x:Key="Gray900">#333333</Color>
    <Color x:Key="Gray950">#141414</Color>

    <!-- ===== Compatibilité avec les anciens noms du modèle ===== -->
    <Color x:Key="PrimaryDark">#F5F5F5</Color>
    <Color x:Key="PrimaryDarkText">#111111</Color>
    <Color x:Key="SecondaryDarkText">#6B6B6B</Color>
    <Color x:Key="Magenta">#D92D20</Color>
    <Color x:Key="MidnightBlue">#121110</Color>
    <Color x:Key="OffBlack">#1F1F1F</Color>

    <!-- ===== Pinceaux ===== -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="NeutralBrush" Color="{StaticResource Neutral}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
